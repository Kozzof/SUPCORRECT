# Copy to /etc/supcorrect/app.env then replace every value.
FLASK_SECRET_KEY=replace-with-a-random-64-character-secret
FLASK_SESSION_COOKIE_SECURE=true
DATABASE_URL=mysql://supcorrect_app:replace-password@db-primary.internal:3306/supcorrect
UPLOAD_MAX_BYTES=65536
GRADER_WORKDIR=/var/lib/supcorrect/work
GRADER_REFERENCE_DIR=/opt/supcorrect/tests/reference
JOB_MAX_ATTEMPTS=3
JOB_LOCK_TIMEOUT_SECONDS=300
