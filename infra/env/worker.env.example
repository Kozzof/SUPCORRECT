# Copy to /etc/supcorrect/app.env on the worker, then replace every value.
FLASK_SECRET_KEY=not-used-by-the-worker-but-must-not-be-a-default
FLASK_SESSION_COOKIE_SECURE=true
DATABASE_URL=mysql://supcorrect_worker:replace-password@db-primary.internal:3306/supcorrect
GRADER_WORKDIR=/var/lib/supcorrect/work
GRADER_REFERENCE_DIR=/opt/supcorrect/tests/reference
JOB_MAX_ATTEMPTS=3
JOB_LOCK_TIMEOUT_SECONDS=300
